{
  "identifier": "eightvoids",
  "description": "What the Eight Voids pages may use in the desktop app: notifications, choosing folders, copying and saving files in folders the person chose (never replacing or deleting their files), reading files in pieces for large uploads, opening links and folders, the read-only Outlook bridge, giving a drawing file its title (rename inside its own folder only), and downloading and opening a new Eight Voids installer when you click Update now. 1.4.1: no access to start-up folders, shell profiles or other programs' saved passwords and keys; programs and scripts are never started from a page. 1.4.2: files can be read and saved only in the synced SharePoint / OneDrive folders (from Windows' own list), the folders the person chooses, and the app's own settings and cache folders – not the rest of the user folder. Updates install only with a valid Eight Voids signature once the update key is set.",
  "windows": [
    "main"
  ],
  "local": true,
  "remote": {
    "urls": [
      "https://eightvoids.com/*",
      "https://www.eightvoids.com/*",
      "https://app.eightvoids.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "notification:default",
    "dialog:allow-open",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/**/*.exe"
        },
        {
          "path": "$HOME/**/*.EXE"
        },
        {
          "path": "$HOME/**/*.bat"
        },
        {
          "path": "$HOME/**/*.cmd"
        },
        {
          "path": "$HOME/**/*.com"
        },
        {
          "path": "$HOME/**/*.ps1"
        },
        {
          "path": "$HOME/**/*.psm1"
        },
        {
          "path": "$HOME/**/*.vbs"
        },
        {
          "path": "$HOME/**/*.vbe"
        },
        {
          "path": "$HOME/**/*.js"
        },
        {
          "path": "$HOME/**/*.jse"
        },
        {
          "path": "$HOME/**/*.wsf"
        },
        {
          "path": "$HOME/**/*.wsh"
        },
        {
          "path": "$HOME/**/*.msi"
        },
        {
          "path": "$HOME/**/*.msp"
        },
        {
          "path": "$HOME/**/*.scr"
        },
        {
          "path": "$HOME/**/*.hta"
        },
        {
          "path": "$HOME/**/*.lnk"
        },
        {
          "path": "$HOME/**/*.url"
        },
        {
          "path": "$HOME/**/*.reg"
        },
        {
          "path": "$HOME/**/*.cpl"
        },
        {
          "path": "$HOME/**/*.jar"
        },
        {
          "path": "$HOME/**/*.application"
        },
        {
          "path": "$HOME/**/*.appref-ms"
        },
        {
          "path": "$HOME/**/*.dll"
        },
        {
          "path": "$HOME/**/*.sys"
        },
        {
          "path": "$HOME/AppData/**"
        }
      ]
    },
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-write",
    "fs:allow-create",
    "fs:allow-stat",
    "fs:allow-seek",
    "fs:allow-read",
    "fs:allow-open",
    "fs:allow-copy-file",
