{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eight Voids",
  "version": "1.3.7",
  "identifier": "com.eightvoids.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Eight Voids",
    "copyright": "© 2026 Eight Voids. All rights reserved.",
    "category": "Business",
    "shortDescription": "Eight Voids app",
    "longDescription": "Eight Voids – one AI-supported workspace for design guardianship, construction administration, architecture & fit-out and BIM.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
